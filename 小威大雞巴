local function CreateToggle(name, yOffset, defaultEnabled)
    local Toggle = Instance.new("TextButton")
    Toggle.Size = UDim2.new(0.9, 0, 0, 40)
    Toggle.Position = UDim2.new(0.05, 0, 0, yOffset)
    Toggle.BackgroundColor3 = defaultEnabled and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(80, 80, 80)
    Toggle.Text = name
    Toggle.TextColor3 = Color3.new(1,1,1)
    Toggle.TextSize = 18
    Toggle.Font = Enum.Font.GothamSemibold
    Toggle.Parent = Frame

    local enabled = defaultEnabled

    Toggle.MouseButton1Click:Connect(function()
        enabled = not enabled

        if name == "玩家ESP" then ESP_ENABLED = enabled
        elseif name == "玩家名" then NAME_ENABLED = enabled
        elseif name == "玩家框框" then BOX_ENABLED = enabled
        elseif name == "玩家射線" then TRACER_ENABLED = enabled
        elseif name == "自瞄" then AIMBOT_ENABLED = enabled end

        Toggle.BackgroundColor3 = enabled and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(80, 80, 80)
    end)

    return Toggle
end

