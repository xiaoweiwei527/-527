-- ==================== 建立 ESP 物件 ====================
local function CreateNameESP(player)
    if player == LocalPlayer then return end
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = ESPFolder

    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.TextColor3 = Color3.fromRGB(255, 80, 80)
    text.TextStrokeTransparency = 0.5
    text.TextScaled = true
    text.Font = Enum.Font.GothamBold
    text.Parent = billboard

    NameLabels[player] = {Billboard = billboard, Text = text}
end

local function CreateBoxESP(player)
    if player == LocalPlayer then return end
    local box = Instance.new("BoxHandleAdornment")
    box.AlwaysOnTop = true
    box.ZIndex = 10
    box.Size = Vector3.new(4, 6, 2)
    box.Color3 = BOX_COLOR_NORMAL
    box.Transparency = 0.35
    box.Parent = ESPFolder
    Boxes[player] = box

    local function Update()
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            box.Adornee = player.Character.HumanoidRootPart
            box.Visible = ESP_ENABLED and BOX_ENABLED
        else
            box.Visible = false
        end
    end
    if player.Character then Update() end
    player.CharacterAdded:Connect(function() task.wait(0.5); Update() end)
    RunService.Heartbeat:Connect(Update)
end

local function CreateTracer(player)
    if player == LocalPlayer then return end
    local line = Drawing.new("Line")
    line.Thickness = 2
    line.Color = Color3.fromRGB(255, 100, 100)
    line.Transparency = 0.75
    Tracers[player] = line
end

-- ==================== 視線檢查（偵測是否被物件擋住子彈） ====================
local function IsLineOfSightClear(targetPart)
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot or not targetPart then return false end

    local direction = (targetPart.Position - myRoot.Position)
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character}
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.IgnoreWater = true

    local result = workspace:Raycast(myRoot.Position, direction, rayParams)
    if result then
        -- 如果打到的不是目標本身，就代表有障礙物擋住
        if not result.Instance:IsDescendantOf(targetPart.Parent) then
            return false
        end
    end
    return true
end

-- ==================== 找最近目標 ====================
local function GetClosestTarget()
    local closest = nil
    local minDist = math.huge

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            local targetPart = player.Character:FindFirstChild(AIM_PART)
            if humanoid and targetPart and humanoid.Health > 10 then
                local origin = Camera.CFrame.Position
                local direction = targetPart.Position - origin

                local params = RaycastParams.new()
                params.FilterDescendantsInstances = {LocalPlayer.Character or Instance.new("Folder")}
                params.FilterType = Enum.RaycastFilterType.Exclude

                local result = workspace:Raycast(origin, direction, params)
                if result == nil or (result.Instance and result.Instance:IsDescendantOf(player.Character)) then
                    local dist = direction.Magnitude
                    if dist < minDist then
                        minDist = dist
                        closest = targetPart
                    end
                end
            end
        end
    end
    return closest
end

-- ==================== 自瞄 + 視線瞬間開槍 ====================
RunService.RenderStepped:Connect(function()
    -- 自瞄本體
    if AIMBOT_ENABLED then
        local target = GetClosestTarget()
        if target then
            local targetCFrame = CFrame.lookAt(Camera.CFrame.Position, target.Position)
            Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, AIM_SMOOTHNESS)

            -- 新增：視線清晰 + 開槍開關啟用 → 瞬間左鍵開槍
            if INSTANT_SHOOT_ENABLED and tick() - lastShootTime > SHOOT_COOLDOWN then
                if IsLineOfSightClear(target) then
                    -- 模擬左鍵按下 → 放開
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)   -- 按下
                    task.wait(0.025)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)  -- 放開

                    lastShootTime = tick()
                end
            end
        end
    end

    -- 框框顏色跟隨自瞄狀態
    for player, box in pairs(Boxes) do
        if box then
            box.Color3 = AIMBOT_ENABLED and BOX_COLOR_AIMING or BOX_COLOR_NORMAL
            box.Visible = ESP_ENABLED and BOX_ENABLED
        end
    end

    -- Name ESP
    for player, data in pairs(NameLabels) do
        if ESP_ENABLED and NAME_ENABLED and player.Character and player.Character:FindFirstChild("Head") and player.Character:FindFirstChild("Humanoid") then
            local head = player.Character.Head
            local humanoid = player.Character.Humanoid
            data.Billboard.Adornee = head
            data.Text.Text = player.Name .. " [" .. math.floor(humanoid.Health) .. "%]"
            data.Billboard.Enabled = true
        else
            if data.Billboard then data.Billboard.Enabled = false end
        end
    end

    -- Tracer
    for player, line in pairs(Tracers) do
        if ESP_ENABLED and TRACER_ENABLED and player.Character and player.Character:FindFirstChild("Head") then
            local headPos = player.Character.Head.Position
            local screenPos, onScreen = Camera:WorldToViewportPoint(headPos)
            if onScreen then
                line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                line.To = Vector2.new(screenPos.X, screenPos.Y)
                line.Visible = true
            else
                line.Visible = false
            end
        else
            line.Visible = false
        end
    end
end)

