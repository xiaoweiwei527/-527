    if gp then return end
    if input.KeyCode == Enum.KeyCode.G then
        AIMBOT_ENABLED = not AIMBOT_ENABLED
        
        if AimToggle then
            AimToggle.BackgroundColor3 = AIMBOT_ENABLED and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(80, 80, 80)
        end

        print(AIMBOT_ENABLED and "🔫 自瞄 已開啟（綠色）" or "🔫 自瞄 已關閉")
    end
end)



